<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Dataverse sandbox plug-ins must target .NET Framework 4.6.2 -->
    <TargetFramework>net462</TargetFramework>
    <LangVersion>latest</LangVersion>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>RestVtp.snk</AssemblyOriginatorKeyFile>
    <RootNamespace>RestVtp.Plugins</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>0.8.0</Version>
  </PropertyGroup>

  <!-- Plug-in package (nupkg) metadata. The provider MUST ship as a package
       rather than a bare assembly, because Newtonsoft.Json is a real runtime
       dependency and only the package format carries it. See DEPLOYMENT.md. -->
  <PropertyGroup>
    <PackageId>RestVtp.Plugins</PackageId>
    <Authors>RestVtp</Authors>
    <Company>RestVtp</Company>
    <Description>Generic REST virtual table data provider for Dataverse. Contains the RestVtp provider plug-ins and their runtime dependencies.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- PrivateAssets="All" on everything the Dataverse host already provides,
         so it is referenced at compile time but NOT packed into the nupkg.
         Newtonsoft.Json deliberately omits it: it must travel in the package. -->
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.56" PrivateAssets="All" />
    <PackageReference Include="Microsoft.PowerApps.MSBuild.Plugin" Version="1.*" PrivateAssets="All" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.*" PrivateAssets="All" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- On net462 System.Net.Http is a framework assembly and is not
         referenced implicitly the way it is on net8.0. HttpExecutor needs it. -->
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <!-- Generate a strong-name key on first build if one doesn't exist:
       sn -k RestVtp.snk  (or use the one committed to the repo) -->

</Project>



